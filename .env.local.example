# ─────────────────────────────────────────────────────────────
# PROXIMA 2.0 — UDAAN UNLOCKED · environment variables
# Copy this file to .env.local and fill in every value.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → "Project URL".
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → "anon" / "publishable" key.
# Safe to expose to the browser; it can only READ (Row Level Security blocks writes).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → "service_role" / "secret" key.
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Password the core team types at /core/login. Server-side only.
CORE_PASSWORD=UDAAN@spit

# Random string (32+ chars) used to sign core login sessions. Server-side only.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Optional: time zone used to display completion times (default Asia/Kolkata).
NEXT_PUBLIC_EVENT_TIMEZONE=Asia/Kolkata
